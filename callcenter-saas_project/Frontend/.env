# .env 
# Frontend Environment Variables

# API Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_URL=http://localhost:3000

# App Information
VITE_APP_NAME=CallCenter Pro
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=AI-Powered Call Center Solutions

# Environment
VITE_NODE_ENV=development

# Feature Flags
VITE_ENABLE_DEMO_BOOKING=true
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_SUPPORT_CHAT=false

# External Services (for future use)
VITE_GOOGLE_ANALYTICS_ID=
VITE_HOTJAR_ID=
VITE_INTERCOM_APP_ID=

# API Keys (for future integrations)
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# Social Media Links
VITE_TWITTER_URL=https://twitter.com/callcenterpro
VITE_LINKEDIN_URL=https://linkedin.com/company/callcenterpro
VITE_GITHUB_URL=https://github.com/callcenterpro

# Contact Information
VITE_CONTACT_EMAIL=support@callcenterpro.com
VITE_CONTACT_PHONE=+1 (555) 123-4567
VITE_CONTACT_ADDRESS=123 Business Ave, Suite 100, City, State 12345